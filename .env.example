# TravelPilot Environment Configuration Template

# Server Port
PORT=5000

# Optional Live LLM API Key (If omitted, system uses 100% offline rule-based parser)
AI_API_KEY=

# Optional Mapbox GL API Key for Custom Vector Tiles
VITE_MAPBOX_ACCESS_TOKEN=

# Optional Weather API Key (OpenWeatherMap / WeatherAPI)
VITE_WEATHER_API_KEY=

# Optional PostgreSQL Connection String for Database Layer
POSTGRES_URI=postgresql://user:password@localhost:5432/travelpilot
